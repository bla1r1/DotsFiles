/*
    macOS Spotlight Modern Dark Theme for Rofi
    Tokyo Night Glass Style
*/

@import "~/.config/rofi/matugen-colors.rasi"

configuration {
    show-icons:         true;
    icon-theme:         "Papirus";
    drun-display-format: "{name}";
}

* {
    font:               "Fira Sans SemiBold 12";
    background-color:   transparent;
    text-color:         @matugen-fg0;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    background-color:   @matugen-bg0;
    border:             1px solid;
    border-color:       @matugen-border;
    border-radius:      16px;
    location:           center;
    width:              680px;
    padding:            14px;
}

mainbox {
    spacing:            12px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @matugen-bg1;
    border:             1px solid;
    border-color:       @matugen-border;
    border-radius:      12px;
    padding:            12px 16px;
    spacing:            12px;
    children:           [ icon-search, entry ];
}

icon-search {
    expand:             false;
    filename:           "search";
    size:               24px;
    vertical-align:     0.5;
}

entry {
    font:               "Fira Sans SemiBold 14";
    placeholder:        "Type to search apps or files...";
    placeholder-color:  @matugen-fg2;
    vertical-align:     0.5;
    text-color:         @matugen-fg0;
}

listview {
    lines:              8;
    columns:            1;
    fixed-height:       false;
    spacing:            4px;
    scrollbar:          false;
}

element {
    padding:            10px 14px;
    spacing:            14px;
    border-radius:      10px;
    background-color:   transparent;
    cursor:             pointer;
}

element normal normal,
element alternate normal {
    background-color:   transparent;
    text-color:         @matugen-fg0;
}

element selected normal,
element selected active {
    background-color:   @matugen-bg3;
    border:             1px solid;
    border-color:       @matugen-border;
    text-color:         @matugen-fg0;
}

element-icon {
    size:               32px;
    vertical-align:     0.5;
}

element-text {
    vertical-align:     0.5;
    text-color:         inherit;
}
