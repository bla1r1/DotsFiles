/*
    macOS Launchpad Fullscreen App Grid for Rofi
    Tokyo Night Glass Style
*/

@import "~/.config/rofi/matugen-colors.rasi"

configuration {
    show-icons:         true;
    icon-theme:         "Papirus";
    drun-display-format: "{name}";
}

* {
    font:               "Fira Sans SemiBold 13";
    background-color:   transparent;
    text-color:         @matugen-fg0;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    background-color:   @matugen-bg0;
    fullscreen:         true;
}

mainbox {
    spacing:            36px;
    padding:            80px 140px 60px 140px;
    children:           [ inputbar-box, listview ];
}

inputbar-box {
    orientation:        horizontal;
    children:           [ dummy-left, inputbar, dummy-right ];
}

dummy-left, dummy-right {
    expand:             true;
}

inputbar {
    background-color:   @matugen-bg1;
    border:             1px solid;
    border-color:       @matugen-border;
    border-radius:      16px;
    padding:            14px 22px;
    spacing:            14px;
    children:           [ icon-search, entry ];
    width:              540px;
}

icon-search {
    expand:             false;
    filename:           "search";
    size:               24px;
    vertical-align:     0.5;
}

entry {
    font:               "Fira Sans SemiBold 16";
    placeholder:        "Search apps...";
    placeholder-color:  @matugen-fg2;
    vertical-align:     0.5;
    text-color:         @matugen-fg0;
}

listview {
    columns:            6;
    lines:              4;
    fixed-columns:      true;
    fixed-height:       false;
    flow:               horizontal;
    spacing:            16px;
    scrollbar:          false;
}

element {
    orientation:        vertical;
    border-radius:      18px;
    padding:            20px 12px 16px 12px;
    spacing:            12px;
    cursor:             pointer;
}

element normal normal,
element alternate normal {
    background-color:   transparent;
    text-color:         @matugen-fg0;
}

element selected normal,
element selected active {
    background-color:   @matugen-bg3;
    border:             1px solid;
    border-color:       @matugen-border;
    text-color:         @matugen-fg0;
}

element-icon {
    size:               64px;
    horizontal-align:   0.5;
    vertical-align:     0.5;
}

element-text {
    font:               "Fira Sans SemiBold 12";
    horizontal-align:   0.5;
    vertical-align:     0.5;
    text-color:         inherit;
}
