# =============================================================================
# xdg-desktop-portal-wlr configuration for b1air Desktop Environment
# Unattended & Persistent Screencast configuration
# =============================================================================
[screencast]
# Output to capture: leave empty to capture focused output, or specify output name
output_name=

# Framerate cap for screencasting
max_fps=60

# Chooser type:
# - none: Silently and automatically capture screen (no dialogs, no prompts)
# - simple: Show basic terminal/text dialog
# - dmenu: Show graphical menu picker
chooser_type=none
