{
  "group/quicklinks": {
    "orientation": "horizontal",
    "modules": [
      "custom/filemanager",
      "custom/browser",
      "custom/terminal"
    ]
  },
  "group/devices": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "custom/mic",
      "custom/monitor-brightness",
      "backlight",
      "custom/kbd-backlight",
      "bluetooth",
      "custom/wifi",
      "battery"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "sway/language",
      "custom/updates",
      "custom/controlcenter",
      "custom/power"
    ]
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "include": [
    "~/.config/waybar/dcol_modules/clock.json"
  ],
  "custom/controlcenter": {
    "format": "󰂚",
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleControl",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleSettings",
    "tooltip-format": "Control Center & Notifications\nRight click: Settings",
    "tooltip": true
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleSession",
    "tooltip-format": "Power & Session Menu ($mod+Shift+E)",
    "tooltip": true
  },
  "custom/updates": {
    "format": "  {}",
    "exec": "~/.config/sway/scripts/system/updates.sh",
    "restart-interval": 60,
    "return-type": "json",
    "escape": true,
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings maintenance",
    "tooltip-format": "{}",
    "tooltip": true
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleNetworkBt",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings bluetooth",
    "tooltip-format": " {device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": " {device_alias}"
  },
  "custom/filemanager": {
    "format": "",
    "on-click": "thunar || nautilus",
    "tooltip": false
  },
  "custom/terminal": {
    "format": "",
    "on-click": "kitty",
    "tooltip": false
  },
  "custom/browser": {
    "format": "",
    "on-click": "brave || firefox",
    "tooltip": false
  },
  "custom/appmenu": {
    "format": "APPS",
    "on-click": "rofi -show drun -theme ~/.config/rofi/launchpad.rasi",
    "on-click-right": "rofi -show drun -theme ~/.config/rofi/spotlight.rasi",
    "tooltip": false
  },
  "custom/wifi": {
    "exec": "bash ~/.config/sway/scripts/waybar/network/wifi-status.sh",
    "return-type": "json",
    "format": "{}",
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleNetworkWifi",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleNetworkBt",
    "on-click-middle": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings network",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}    {volume}%",
    "format-muted": "",
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleVolume",
    "on-click-middle": "bash ~/.config/sway/scripts/controls/audio-control.sh --toggle",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings audio",
    "on-scroll-up": "bash ~/.config/sway/scripts/controls/audio-control.sh --inc 5",
    "on-scroll-down": "bash ~/.config/sway/scripts/controls/audio-control.sh --dec 5",
    "tooltip-format": "{icon} {desc}",
    "format-icons": {
      "headphone": ["", "", ""],
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  },
  "custom/mic": {
    "exec": "bash ~/.config/sway/scripts/controls/mic-control.sh --get-waybar",
    "interval": "once",
    "signal": 1,
    "format": "{}",
    "on-click": "bash ~/.config/sway/scripts/controls/mic-control.sh --toggle",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleVolume",
    "tooltip-format": "Left click: toggle mic\nRight click: volume panel",
    "tooltip": true
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%  ⬆",
    "format-plugged": "󰚥  {capacity}%",
    "format-full": "󰁹  Full",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleBattery",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings power",
    "tooltip-format": "{timeTo} — {power}W  ({capacity}%)",
    "interval": 30
  },
  "custom/player": {
    "exec": "bash ~/.config/sway/scripts/waybar/media/player-status.sh",
    "return-type": "json",
    "max-length": 34,
    "format": "{}",
    "on-click": "playerctl play-pause",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleMusic",
    "on-click-middle": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },
  "backlight": {
    "exec-if": "bash ~/.config/sway/scripts/controls/brightness-control.sh available",
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleMonitors",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings monitors",
    "on-scroll-up": "bash ~/.config/sway/scripts/controls/brightness-control.sh up",
    "on-scroll-down": "bash ~/.config/sway/scripts/controls/brightness-control.sh down",
    "tooltip-format": "Scroll: laptop brightness\nClick: monitor brightness panel",
    "tooltip": true
  },
  "custom/monitor-brightness": {
    "exec": "bash ~/.config/sway/scripts/controls/monitor-brightness.sh waybar",
    "return-type": "json",
    "interval": "once",
    "signal": 3,
    "format": "{}",
    "hide-empty": true,
    "on-click": "qs -p ~/.config/quickshell/Main.qml ipc call main toggleMonitors",
    "on-click-right": "qs -p ~/.config/quickshell/Main.qml ipc call main open settings monitors",
    "on-scroll-up": "bash ~/.config/sway/scripts/controls/monitor-brightness.sh up",
    "on-scroll-down": "bash ~/.config/sway/scripts/controls/monitor-brightness.sh down",
    "tooltip": true
  },
  "custom/kbd-backlight": {
    "exec-if": "bash ~/.config/sway/scripts/controls/kbd-backlight.sh --available",
    "exec": "bash ~/.config/sway/scripts/controls/kbd-backlight.sh --get",
    "interval": "once",
    "signal": 2,
    "format": "󰌌  {}%",
    "on-scroll-up": "bash ~/.config/sway/scripts/controls/kbd-backlight.sh --inc",
    "on-scroll-down": "bash ~/.config/sway/scripts/controls/kbd-backlight.sh --dec",
    "on-click": "bash ~/.config/sway/scripts/controls/kbd-backlight.sh --off",
    "tooltip-format": "Scroll: adjust\nClick: turn off",
    "tooltip": true
  },
  "cpu": {
    "format": "    {usage}%",
    "interval": 2,
    "on-click": "kitty --title btop -e btop",
    "tooltip": false
  },
  "memory": {
    "format": "󰍛    {used:0.1f}G",
    "interval": 5,
    "on-click": "kitty --title btop -e btop",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used\n{avail:0.1f}G available"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon}  {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "interval": 5,
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "icon-theme": "Papirus-Dark",
    "spacing": 0,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "ignore-list": [
      "alacritty-dropterm",
      "feathernotes",
      "ranger",
      "org.keepassxc.KeePassXC"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    }
  },
  "sway/language": {
    "format": "󰌌   {}",
    "format-en": "EN",
    "format-uk": "UA",
    "format-de": "DE",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": false
  },
  "sway/workspaces": {
    "on-scroll-up": "swaymsg workspace prev",
    "on-scroll-down": "swaymsg workspace next",
    "all-outputs": true,
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    }
  }
}
