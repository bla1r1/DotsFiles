#!/usr/bin/env bash
# =============================================================================
# b1air-files — Native C++20 / Qt6 File Manager & Gallery Launcher
# =============================================================================
set -euo pipefail

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
fi

export QT_QPA_PLATFORM="wayland;xcb"
export QSG_RENDER_LOOP="basic"
export QML_DISABLE_DISK_CACHE="0"

if [[ -x "$HOME/DotsFiles/src/shell/build/b1air-files" ]]; then
    exec "$HOME/DotsFiles/src/shell/build/b1air-files" "$@"
fi

exec /usr/local/bin/b1air-files "$@"
