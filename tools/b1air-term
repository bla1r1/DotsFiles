#!/usr/bin/env bash
# =============================================================================
# b1air-term — Native Wayland Desktop Terminal Emulator Launcher
# =============================================================================
set -euo pipefail

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
fi

export QT_QPA_PLATFORM="wayland;xcb"
export QSG_RENDER_LOOP="basic"
export QML_DISABLE_DISK_CACHE="0"

if [[ -x "$HOME/DotsFiles/src/shell/build/b1air-term" ]]; then
    exec "$HOME/DotsFiles/src/shell/build/b1air-term" "$@"
fi

if [[ -x "/usr/local/bin/b1air-term" ]]; then
    exec /usr/local/bin/b1air-term "$@"
fi

TERM_BIN="$(command -v b1air-term || true)"
if [[ -n "$TERM_BIN" && -x "$TERM_BIN" ]]; then
    exec "$TERM_BIN" "$@"
fi

echo "Error: b1air-term binary not found! Please build src/ first." >&2
exit 1
