#!/usr/bin/env bash
# =============================================================================
# b1air-text — Native Minimal Text & Config Editor Launcher
# =============================================================================
set -euo pipefail

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
fi

export QT_QPA_PLATFORM="wayland;xcb"
export QSG_RENDER_LOOP="basic"
export QML_DISABLE_DISK_CACHE="0"

if [[ -x "$HOME/DotsFiles/src/shell/build/b1air-text" ]]; then
    exec "$HOME/DotsFiles/src/shell/build/b1air-text" "$@"
fi

exec /usr/local/bin/b1air-text "$@"
