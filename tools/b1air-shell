#!/usr/bin/env bash
# =============================================================================
# b1air-shell — D-Bus Desktop Shell Dispatcher (org.b1air.Shell)
# Sub-millisecond latency • Native D-Bus RPC • Fallback to quickshell IPC
# =============================================================================
ACTION="${1:-toggle}"
TARGET="${2:-launcher}"
ARG="${3:-}"

# 1. Try Native D-Bus dispatch (sub-millisecond)
case "$ACTION" in
    toggle|Toggle)
        if busctl --user call org.b1air.Shell /org/b1air/Shell org.b1air.Shell Toggle s "$TARGET" >/dev/null 2>&1; then
            exit 0
        fi
        ;;
    open|Open)
        if busctl --user call org.b1air.Shell /org/b1air/Shell org.b1air.Shell Open ss "$TARGET" "$ARG" >/dev/null 2>&1; then
            exit 0
        fi
        ;;
    close|Close)
        if busctl --user call org.b1air.Shell /org/b1air/Shell org.b1air.Shell Close s "$TARGET" >/dev/null 2>&1; then
            exit 0
        fi
        ;;
    reload|forceReload|ForceReload)
        if busctl --user call org.b1air.Shell /org/b1air/Shell org.b1air.Shell ForceReload >/dev/null 2>&1; then
            exit 0
        fi
        ;;
esac

# 2. Quickshell IPC Fallback if D-Bus service is offline
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    export WAYLAND_DISPLAY=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n 1 | xargs -n 1 basename 2>/dev/null || echo "wayland-1")
fi
export SWAYSOCK=$(ls -t "$XDG_RUNTIME_DIR"/sway-ipc.*.sock 2>/dev/null | head -n 1)

if [ -z "$TARGET" ]; then
    quickshell -p ~/.config/quickshell/Main.qml ipc call main "$ACTION" >/dev/null 2>&1 || true
else
    quickshell -p ~/.config/quickshell/Main.qml ipc call main "$ACTION" "$TARGET" "$ARG" >/dev/null 2>&1 || true
fi
