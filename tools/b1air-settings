#!/usr/bin/env bash
# =============================================================================
# b1air-settings — Desktop Settings Application Launcher
# =============================================================================
set -euo pipefail

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="$(basename "$s")"
            break
        fi
    done
fi

export QT_QPA_PLATFORM="wayland;xcb"
export QSG_RENDER_LOOP="basic"
export QML_DISABLE_DISK_CACHE="0"

if [[ $# -gt 0 && -n "$1" ]]; then
    export INITIAL_SETTINGS_PAGE="$1"
fi

SETTINGS_QML="$HOME/DotsFiles/src/apps/settings/SettingsWindow.qml"
if [[ ! -f "$SETTINGS_QML" ]]; then
    SETTINGS_QML="$HOME/DotsFiles/src/shell/qml/SettingsWindow.qml"
fi
if [[ ! -f "$SETTINGS_QML" ]]; then
    SETTINGS_QML="$HOME/.config/quickshell/SettingsWindow.qml"
fi

exec quickshell -p "$SETTINGS_QML"
