#!/usr/bin/env bash
# ==============================================================================
# b1air Desktop Environment Session Launcher
# ==============================================================================

export XDG_CURRENT_DESKTOP="b1air:sway"
export XDG_SESSION_DESKTOP="b1air"
export XDG_SESSION_TYPE="wayland"

# The whole b1air-files/term/notes/git/monitor/view/text/settings suite
# installs to ~/.local/bin (make PREFIX="$HOME/.local/bin" install), not
# /usr/local/bin — SDDM's own environment has no reason to include it, so
# every Quickshell.execDetached(["b1air-files"]) etc. execvp'd straight into
# "command not found" with nothing surfacing the failure. Everything spawned
# from this session (sway, quickshell, the daemon) inherits this PATH.
export PATH="$HOME/.local/bin:$PATH"

# Wayland & Toolkit Defaults
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11,*"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland"
export _JAVA_AWT_WM_NONREPARENTING=1

# Some launchers (including the VM's SSH-based graphical launcher) do not pass
# the user bus variables through.  Restore only the standard session paths.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

# Fallback software rendering if in VM
if [ -n "$WLR_RENDERER_ALLOW_SOFTWARE" ] || lspci 2>/dev/null | grep -iE 'qemu|virtualbox|vmware' >/dev/null 2>&1; then
    export WLR_NO_HARDWARE_CURSORS=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    # ponytail: no GPU means Qt Quick's GL path runs through llvmpipe, which
    # repaints the whole window every frame. The QPainter backend does dirty-rect
    # updates instead: measured 28% -> 10% CPU on an animating window, 5% -> 0%
    # idle. Set B1AIR_FORCE_GL=1 if the VM actually has working virgl.
    if [ -z "${B1AIR_FORCE_GL:-}" ]; then
        export QT_QUICK_BACKEND=software
        unset QSG_RHI_BACKEND
        # ponytail: same story one layer down — wlroots' gles2 path composites the
        # whole screen through llvmpipe. pixman rasterises directly and measured
        # 22-25% -> 2-3% CPU on this VM. Costs GL/dmabuf clients their fast path,
        # which is moot when there is no GPU to accelerate them anyway.
        export WLR_RENDERER=pixman
    fi
fi

# Import environment to systemd user instance & D-Bus
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR PATH HOME USER LANG \
        WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE QT_QPA_PLATFORM QT_QUICK_BACKEND QSG_RHI_BACKEND \
        QSG_RENDER_LOOP MOZ_ENABLE_WAYLAND GDK_BACKEND WLR_RENDERER \
        WLR_RENDERER_ALLOW_SOFTWARE WLR_NO_HARDWARE_CURSORS
fi

# Prefer SwayFX so the configured rounded corners/blur are actually applied.
# Keep vanilla Sway as a functional fallback for installations using --no-aur.
if command -v swayfx >/dev/null 2>&1; then
    exec swayfx -c "${HOME}/.config/sway/config" "$@"
else
    exec sway -c "${HOME}/.config/sway/config" "$@"
fi
