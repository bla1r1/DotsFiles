#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SETTINGSCTL="$SCRIPT_DIR/settingsctl"
CONFIG="$(cd -- "$SCRIPT_DIR/.." && pwd)/default.conf"

usage() {
    cat <<EOF
Usage:
  settings-tui [--config PATH]

Interactive persistent settings editor for the Blair SDDM theme.

Use sudo when editing the installed theme:
  sudo /usr/share/sddm/themes/blair/tools/settings-tui
EOF
}

die() {
    printf 'settings-tui: %s\n' "$*" >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)
            [[ $# -ge 2 ]] || die "--config requires a path"
            CONFIG="$2"
            shift 2
            ;;
        --config=*)
            CONFIG="${1#--config=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

[[ -x "$SETTINGSCTL" ]] || die "settingsctl not found or not executable: $SETTINGSCTL"
[[ -f "$CONFIG" ]] || die "config not found: $CONFIG"
command -v whiptail >/dev/null 2>&1 || die "whiptail is required for settings-tui"

ctl() {
    "$SETTINGSCTL" --config "$CONFIG" "$@"
}

get_value() {
    ctl get "$1" "$2" 2>/dev/null || true
}

clean_value() {
    local value="$1"
    value="${value#\"}"
    value="${value%\"}"
    printf '%s' "$value"
}

current() {
    clean_value "$(get_value "$1" "$2")"
}

set_raw() {
    ctl set "$1" "$2" "$3" >/dev/null
}

set_string() {
    ctl set-string "$1" "$2" "$3" >/dev/null
}

set_bool() {
    ctl set-bool "$1" "$2" "$3" >/dev/null
}

toggle_bool() {
    local section="$1"
    local key="$2"
    local value

    value="$(current "$section" "$key")"
    if [[ "$value" == "true" ]]; then
        set_bool "$section" "$key" false
    else
        set_bool "$section" "$key" true
    fi
}

choose_value() {
    local title="$1"
    local section="$2"
    local key="$3"
    local current_value="$4"
    shift 4

    local choices=()
    local value
    for value in "$@"; do
        choices+=("$value" "$([[ "$value" == "$current_value" ]] && printf current || printf ' ')")
    done

    local selected
    selected="$(whiptail --title "$title" --menu "Current: $current_value" 18 70 9 "${choices[@]}" 3>&1 1>&2 2>&3)" || return 0
    set_string "$section" "$key" "$selected"
}

choose_raw_value() {
    local title="$1"
    local section="$2"
    local key="$3"
    local current_value="$4"
    shift 4

    local choices=()
    local value
    for value in "$@"; do
        choices+=("$value" "$([[ "$value" == "$current_value" ]] && printf current || printf ' ')")
    done

    local selected
    selected="$(whiptail --title "$title" --menu "Current: $current_value" 18 70 9 "${choices[@]}" 3>&1 1>&2 2>&3)" || return 0
    set_raw "$section" "$key" "$selected"
}

input_string() {
    local title="$1"
    local section="$2"
    local key="$3"
    local value

    value="$(whiptail --title "$title" --inputbox "$section / $key" 10 70 "$(current "$section" "$key")" 3>&1 1>&2 2>&3)" || return 0
    set_string "$section" "$key" "$value"
}

input_raw() {
    local title="$1"
    local section="$2"
    local key="$3"
    local value

    value="$(whiptail --title "$title" --inputbox "$section / $key" 10 70 "$(current "$section" "$key")" 3>&1 1>&2 2>&3)" || return 0
    set_raw "$section" "$key" "$value"
}

status_label() {
    local value="$1"
    case "$value" in
        true) printf 'on' ;;
        false) printf 'off' ;;
        *) printf '%s' "$value" ;;
    esac
}

main_menu() {
    whiptail --title "Blair Settings" --menu \
"Persistent editor for:
$CONFIG

Runtime preview lives inside SDDM. This editor saves defaults for next load." \
        22 78 10 \
        appearance "Animations, fill mode, scale" \
        lock "Clock, date, message, lock effects" \
        login "Login position and login effects" \
        info "Info and weather placeholder" \
        displays "Target monitor" \
        keyboard "Layout and virtual keyboard" \
        menus "Quick menu visibility" \
        power "Power menu" \
        advanced "Status" \
        quit "Exit" \
        3>&1 1>&2 2>&3
}

appearance_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Appearance" --menu "Choose a setting." 18 72 8 \
            animations "Animations: $(status_label "$(current General enable-animations)")" \
            fill "Background fill: $(current General background-fill-mode)" \
            scale "Scale: $(current General scale)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            animations) toggle_bool General enable-animations ;;
            fill) choose_value "Background fill" General background-fill-mode "$(current General background-fill-mode)" fill fit stretch ;;
            scale) input_raw "Scale" General scale ;;
            back) return 0 ;;
        esac
    done
}

lock_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Lock Screen" --menu "Choose a setting." 24 78 14 \
            clock "Clock: $(status_label "$(current LockScreen.Clock display)")" \
            date "Date: $(status_label "$(current LockScreen.Date display)")" \
            clock_pos "Clock position: $(current LockScreen.Clock position)" \
            clock_format "Clock format: $(current LockScreen.Clock format)" \
            message "Message: $(status_label "$(current LockScreen.Message display)")" \
            message_pos "Message position: $(current LockScreen.Message position)" \
            message_text "Message text: $(current LockScreen.Message text)" \
            blur "Blur: $(current LockScreen blur)" \
            brightness "Brightness: $(current LockScreen brightness)" \
            saturation "Saturation: $(current LockScreen saturation)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            clock) toggle_bool LockScreen.Clock display ;;
            date) toggle_bool LockScreen.Date display ;;
            clock_pos) choose_value "Clock position" LockScreen.Clock position "$(current LockScreen.Clock position)" top-left top-center top-right center-left center center-right bottom-left bottom-center bottom-right ;;
            clock_format) choose_value "Clock format" LockScreen.Clock format "$(current LockScreen.Clock format)" "hh:mm" "h:mm AP" "HH:mm:ss" ;;
            message) toggle_bool LockScreen.Message display ;;
            message_pos) choose_value "Message position" LockScreen.Message position "$(current LockScreen.Message position)" top-left top-center top-right center-left center center-right bottom-left bottom-center bottom-right ;;
            message_text) input_string "Message text" LockScreen.Message text ;;
            blur) input_raw "Lock blur" LockScreen blur ;;
            brightness) input_raw "Lock brightness" LockScreen brightness ;;
            saturation) input_raw "Lock saturation" LockScreen saturation ;;
            back) return 0 ;;
        esac
    done
}

login_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Login" --menu "Choose a setting." 21 76 11 \
            position "Login position: $(current LoginScreen.LoginArea position)" \
            avatar "Avatar shape: $(current LoginScreen.LoginArea.Avatar shape)" \
            button_text "Login button text: $(status_label "$(current LoginScreen.LoginArea.LoginButton show-text-if-no-password)")" \
            hide_button "Hide extra button: $(status_label "$(current LoginScreen.LoginArea.LoginButton hide-if-not-needed)")" \
            blur "Blur: $(current LoginScreen blur)" \
            brightness "Brightness: $(current LoginScreen brightness)" \
            saturation "Saturation: $(current LoginScreen saturation)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            position) choose_value "Login position" LoginScreen.LoginArea position "$(current LoginScreen.LoginArea position)" center left right ;;
            avatar) choose_value "Avatar shape" LoginScreen.LoginArea.Avatar shape "$(current LoginScreen.LoginArea.Avatar shape)" circle square ;;
            button_text) toggle_bool LoginScreen.LoginArea.LoginButton show-text-if-no-password ;;
            hide_button) toggle_bool LoginScreen.LoginArea.LoginButton hide-if-not-needed ;;
            blur) input_raw "Login blur" LoginScreen blur ;;
            brightness) input_raw "Login brightness" LoginScreen brightness ;;
            saturation) input_raw "Login saturation" LoginScreen saturation ;;
            back) return 0 ;;
        esac
    done
}

info_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Info & Weather" --menu "Choose a setting." 22 78 12 \
            display "Info block: $(status_label "$(current LockScreen.Info display)")" \
            date "Date line: $(status_label "$(current LockScreen.Info display-date)")" \
            weather "Weather line: $(status_label "$(current LockScreen.Info display-weather)")" \
            location "Location: $(current LockScreen.Info weather-location)" \
            units "Units: $(current LockScreen.Info weather-units)" \
            text "Weather text: $(current LockScreen.Info weather-text)" \
            position "Position: $(current LockScreen.Info position)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            display) toggle_bool LockScreen.Info display ;;
            date) toggle_bool LockScreen.Info display-date ;;
            weather) toggle_bool LockScreen.Info display-weather ;;
            location) input_string "Weather location" LockScreen.Info weather-location ;;
            units) choose_value "Weather units" LockScreen.Info weather-units "$(current LockScreen.Info weather-units)" C F ;;
            text) input_string "Weather text" LockScreen.Info weather-text ;;
            position) choose_value "Info block position" LockScreen.Info position "$(current LockScreen.Info position)" top-left top-center top-right center-left center center-right bottom-left bottom-center bottom-right ;;
            back) return 0 ;;
        esac
    done
}

displays_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Displays" --menu "Choose a setting." 16 72 6 \
            target "Target: $(current Displays target)" \
            index "Index: $(current Displays index)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            target) choose_value "Display target" Displays target "$(current Displays target)" primary index ;;
            index) choose_raw_value "Display index" Displays index "$(current Displays index)" 0 1 2 3 ;;
            back) return 0 ;;
        esac
    done
}

keyboard_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Keyboard" --menu "Choose a setting." 18 76 8 \
            layout "Layout button: $(status_label "$(current LoginScreen.MenuArea.Layout display)")" \
            layout_label "Layout label: $(status_label "$(current LoginScreen.MenuArea.Layout display-layout-name)")" \
            keyboard "Keyboard button: $(status_label "$(current LoginScreen.MenuArea.Keyboard display)")" \
            start_hidden "Keyboard starts hidden: $(status_label "$(current LoginScreen.VirtualKeyboard start-hidden)")" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            layout) toggle_bool LoginScreen.MenuArea.Layout display ;;
            layout_label) toggle_bool LoginScreen.MenuArea.Layout display-layout-name ;;
            keyboard) toggle_bool LoginScreen.MenuArea.Keyboard display ;;
            start_hidden) toggle_bool LoginScreen.VirtualKeyboard start-hidden ;;
            back) return 0 ;;
        esac
    done
}

menus_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Quick Menus" --menu "Choose a setting." 18 76 8 \
            session "Session: $(status_label "$(current LoginScreen.MenuArea.Session display)")" \
            layout "Layout: $(status_label "$(current LoginScreen.MenuArea.Layout display)")" \
            keyboard "Keyboard: $(status_label "$(current LoginScreen.MenuArea.Keyboard display)")" \
            power "Power: $(status_label "$(current LoginScreen.MenuArea.Power display)")" \
            settings "Settings: $(status_label "$(current LoginScreen.MenuArea.Settings display)")" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            session) toggle_bool LoginScreen.MenuArea.Session display ;;
            layout) toggle_bool LoginScreen.MenuArea.Layout display ;;
            keyboard) toggle_bool LoginScreen.MenuArea.Keyboard display ;;
            power) toggle_bool LoginScreen.MenuArea.Power display ;;
            settings) toggle_bool LoginScreen.MenuArea.Settings display ;;
            back) return 0 ;;
        esac
    done
}

power_menu() {
    local choice
    while true; do
        choice="$(whiptail --title "Power" --menu "Choose a setting." 16 72 6 \
            display "Power button: $(status_label "$(current LoginScreen.MenuArea.Power display)")" \
            width "Popup width: $(current LoginScreen.MenuArea.Power popup-width)" \
            back "Back" \
            3>&1 1>&2 2>&3)" || return 0
        case "$choice" in
            display) toggle_bool LoginScreen.MenuArea.Power display ;;
            width) input_raw "Power popup width" LoginScreen.MenuArea.Power popup-width ;;
            back) return 0 ;;
        esac
    done
}

advanced_menu() {
    whiptail --title "Advanced" --msgbox \
"Runtime preview:
  Available inside the SDDM settings panel.

Persistent editor:
  This TUI writes to default.conf through settingsctl.

Weather provider:
  UI and placeholder config are ready. A live provider is not connected yet.

Backups:
  settingsctl creates timestamped .bak files before every write." \
        18 74
}

while true; do
    choice="$(main_menu)" || exit 0
    case "$choice" in
        appearance) appearance_menu ;;
        lock) lock_menu ;;
        login) login_menu ;;
        info) info_menu ;;
        displays) displays_menu ;;
        keyboard) keyboard_menu ;;
        menus) menus_menu ;;
        power) power_menu ;;
        advanced) advanced_menu ;;
        quit) exit 0 ;;
    esac
done
