[Desktop Entry]
Type=Application
Name=b1air Files
Comment=Native b1air file manager
Exec=b1air-files %U
Icon=system-file-manager
Terminal=false
MimeType=inode/directory;application/zip;application/x-tar;application/x-7z-compressed;application/x-rar;application/gzip;application/x-xz;application/x-zstd-compressed-tar;
Categories=System;FileManager;Utility;
Keywords=files;folders;explorer;
StartupWMClass=b1air-files

